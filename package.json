{
  "name": "conduc-rail",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test $(find src -name \"*.test.ts\")",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && SEED_SI_VIDE=1 prisma db seed && next build"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
